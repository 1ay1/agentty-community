# Discord bot config — copy this to `.env` and fill in the values.
# NEVER commit `.env`. The token is a full credential; treat it like a password.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Your server (guild) ID. Slash commands register instantly on it.
DISCORD_GUILD_ID=

# Who gets the owner DMs (joins, leaves, first messages, GitHub events, answer
# feedback, the daily pulse). Defaults to the server owner.
DISCORD_OWNER_ID=
# Your GitHub login, for `/notify github: everything except my own`.
OWNER_GITHUB_LOGIN=1ay1

# GitHub. The token is optional; without it the bot falls back to `gh auth
# token`. With repo access, the owner's "Send to GitHub issue" files the issue
# directly. Everyone else gets a prefilled link to submit under their own account.
GITHUB_REPO=agentty-org/agentty
GITHUB_TOKEN=

# Local hour for the daily pulse DM (empty = off). How often to poll releases.
PULSE_DAILY_HOUR=21
RELEASE_POLL_SECONDS=120
# Cheer in #campfire each time stars cross a multiple of this.
STAR_MILESTONE_STEP=50

# The agent the bot answers with (see acp_brain.py). FAST handles simple
# lookups; SMART handles judgement calls (bugs, "is he right?", design), every
# owner conversation, and the pulse. Routing is local and free.
ACP_WORKSPACE=/path/to/agentty
ACP_MODEL=claude-haiku-4-5
ACP_SMART_MODEL=claude-sonnet-5-5

# Everyone except the owner gets a SCOPED agent: agentty questions only, no DMs,
# a clean public clone + isolated AGENTTY_HOME (none of the owner's memory).
PUBLIC_WORKSPACE=~/.cache/agentty-bot/src
PUBLIC_AGENTTY_HOME=~/.cache/agentty-bot/home
PUBLIC_ASKS_PER_HOUR=10
PUBLIC_ASKS_PER_DAY=30
PUBLIC_SMART_PER_DAY=8
PUBLIC_ASKS_SERVER_DAY=150
