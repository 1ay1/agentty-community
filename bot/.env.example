# Discord bot config — copy this to `.env` and fill in the values.
# NEVER commit `.env`. The token is a full credential; treat it like a password.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Optional but recommended: your server (guild) ID. With it, slash commands
# register instantly on your server; without it they register globally (up to
# ~1h to appear). Enable Developer Mode in Discord, then right-click the server
# icon → Copy Server ID.
DISCORD_GUILD_ID=

# Optional: channel IDs. Right-click a channel → Copy Channel ID.
#   WELCOME — where public join messages go (leave 0 to disable)
#   HELP    — the bot only auto-answers FAQ keywords here (0 = every channel)
DISCORD_WELCOME_CHANNEL_ID=0
DISCORD_HELP_CHANNEL_ID=0
